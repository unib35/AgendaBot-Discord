# 필수 - Discord 봇 인증 정보
DISCORD_TOKEN=봇토큰
DISCORD_APP_ID=애플리케이션ID

# 선택 - 개발/디버깅
DEV_GUILD_ID=        # 개발 중 길드 명령 배포 시 사용 (비우면 글로벌 배포)
SQL_DEBUG=0          # 1로 설정 시 SQL 쿼리 로그 출력

# 선택 - 기본값 (서버별 설정은 /setup 명령어로 관리)
TIMEZONE=Asia/Seoul  # 시간대 설정

# 선택 - AI 요약 기능 (전역 기본값, 서버별 설정 우선)
GOOGLE_API_KEY=      # Google AI Studio에서 발급 (서버별 설정 가능)
GEMINI_MODEL=gemini-2.0-flash-exp  # 사용할 Gemini 모델 (서버별 설정 가능)

# 선택 - 자동 요약 스케줄 (전역 기본값)
SUMMARY_CRON=0 9 * * MON  # 매주 월요일 09:00 (cron 표현식)

# 보안 - API 키 암호화용 시크릿 (프로덕션에서 반드시 변경)
ENCRYPTION_SECRET=   # openssl rand -hex 32 로 생성 권장

# 참고: 채널 설정은 /setup 명령어를 통해 서버별로 관리됩니다.
# - tracking_channel: 안건이 등록될 출력 채널
# - command_channel: 명령어를 입력할 채널
# - allowed_role: 명령어 사용 권한 역할
